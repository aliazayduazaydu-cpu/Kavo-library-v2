	ContentArea.Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, 0)
	ContentArea.Position = UDim2.new(0, SIDEBAR_WIDTH, 0, 0)
	ContentArea.BackgroundTransparency = 1
	ContentArea.Parent = ContentMain

	-- Draggable Floating Open/Close Toggle Button (The ONLY moving toggle; Box stays fixed)
	local FloatingToggle = Instance.new("TextButton")
	FloatingToggle.Name = "SUFFIXToggleButton"
	FloatingToggle.Size = UDim2.fromOffset(44, 44)
	FloatingToggle.Position = UDim2.new(0, 18, 0.45, 0)
	FloatingToggle.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
	FloatingToggle.Text = "UI"
	FloatingToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
	FloatingToggle.Font = Enum.Font.GothamBold
	FloatingToggle.TextSize = 13
	FloatingToggle.AutoButtonColor = false
	FloatingToggle.ZIndex = 50
	FloatingToggle.Parent = ScreenGui

	local ToggleCorner = Instance.new("UICorner")
	ToggleCorner.CornerRadius = UDim.new(0, 8)
	ToggleCorner.Parent = FloatingToggle

	local ToggleStroke = Instance.new("UIStroke")
	ToggleStroke.Color = Color3.fromRGB(70, 70, 70)
	ToggleStroke.Thickness = 1.2
	ToggleStroke.Parent = FloatingToggle

	local isOpen = true

	local function setWindowOpen(state)
		isOpen = state
		Box.Visible = isOpen
		FloatingToggle.Text = isOpen and "UI" or "OPEN"
		ToggleStroke.Color = isOpen and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(0, 255, 120)
	end

	MinimizeButton.MouseButton1Click:Connect(function()
		setWindowOpen(false)
	end)

	do
		local btnDragging = false
		local btnDragInput
		local btnStartPos
		local btnStartFramePos
		local moved = false
		local ignoreNextClick = false

		FloatingToggle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				btnDragging = true
				btnDragInput = input
				moved = false
				btnStartPos = input.Position
				btnStartFramePos = FloatingToggle.Position

				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						btnDragging = false
						if moved then
							ignoreNextClick = true
							task.delay(0.05, function()
								ignoreNextClick = false
							end)
						end
					end
				end)
			end
		end)

		FloatingToggle.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				btnDragInput = input
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if input == btnDragInput and btnDragging then
				local delta = input.Position - btnStartPos
				if delta.Magnitude > 6 then
					moved = true
				end
				local maxX = math.max(0, ScreenGui.AbsoluteSize.X - FloatingToggle.AbsoluteSize.X)
				local maxY = math.max(0, ScreenGui.AbsoluteSize.Y - FloatingToggle.AbsoluteSize.Y)
				local newX = math.clamp(btnStartFramePos.X.Offset + delta.X, 0, maxX)
				local newY = math.clamp(btnStartFramePos.Y.Offset + delta.Y, 0, maxY)
				FloatingToggle.Position = UDim2.new(btnStartFramePos.X.Scale, newX, btnStartFramePos.Y.Scale, newY)
			end
		end)

		FloatingToggle.MouseButton1Click:Connect(function()
			if ignoreNextClick then return end
			setWindowOpen(not isOpen)
		end)
	end

	self.TabButtons = {}
	self.Pages = {}
	self.TabList = TabList
	self.ContentArea = ContentArea
	self.ScreenGui = ScreenGui
	self.Box = Box
	self.Toggle = setWindowOpen

	return self
end

function SUFFIX:CreateTab(iconInput)
	local resolvedIcon = self:ResolveIcon(iconInput)

	local TabBtn = Instance.new("ImageButton")
	TabBtn.Size = UDim2.new(0, 34, 0, 34)
	TabBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
	TabBtn.BorderSizePixel = 0
	TabBtn.Image = resolvedIcon
	TabBtn.ImageColor3 = Color3.fromRGB(150, 150, 150)
	TabBtn.Parent = self.TabList

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 6)
	Corner.Parent = TabBtn

	local Page = Instance.new("ScrollingFrame")
	Page.Size = UDim2.new(1, 0, 1, 0)
	Page.BackgroundTransparency = 1
	Page.BorderSizePixel = 0
	Page.ScrollBarThickness = 3
	Page.CanvasSize = UDim2.new(0, 0, 0, 0)
	Page.Visible = false
	Page.Parent = self.ContentArea

	local PageLayout = Instance.new("UIListLayout")
	PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	PageLayout.Padding = UDim.new(0, 6)
	PageLayout.Parent = Page

	local PagePadding = Instance.new("UIPadding")
	PagePadding.PaddingTop = UDim.new(0, 10)
	PagePadding.PaddingLeft = UDim.new(0, 10)
	PagePadding.PaddingRight = UDim.new(0, 10)
	PagePadding.PaddingBottom = UDim.new(0, 10)
	PagePadding.Parent = Page

	local function refreshCanvas()
		Page.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 20)
	end

	PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshCanvas)

	table.insert(self.TabButtons, TabBtn)
	table.insert(self.Pages, Page)

	if #self.Pages == 1 then
		Page.Visible = true
		TabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		TabBtn.ImageColor3 = Color3.fromRGB(255, 255, 255)
	end

	TabBtn.MouseButton1Click:Connect(function()
		for _, p in ipairs(self.Pages) do p.Visible = false end
		for _, t in ipairs(self.TabButtons) do
			t.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
			t.ImageColor3 = Color3.fromRGB(150, 150, 150)
		end
		Page.Visible = true
		TabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		TabBtn.ImageColor3 = Color3.fromRGB(255, 255, 255)
		refreshCanvas()
	end)

	local TabObj = {}

	function TabObj:CreateSection(sectionText)
		local SecLabel = Instance.new("TextLabel")
		SecLabel.Size = UDim2.new(1, 0, 0, 20)
		SecLabel.BackgroundTransparency = 1
		SecLabel.Text = "  " .. sectionText
		SecLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
		SecLabel.TextSize = 12
		SecLabel.Font = Enum.Font.GothamBold
		SecLabel.TextXAlignment = Enum.TextXAlignment.Left
		SecLabel.Parent = Page
		refreshCanvas()
		return SecLabel
	end

	function TabObj:CreateButton(name, callback)
		local Btn = Instance.new("TextButton")
		Btn.Size = UDim2.new(1, 0, 0, 30)
		Btn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
		Btn.Text = "  " .. name
		Btn.TextColor3 = Color3.fromRGB(230, 230, 230)
		Btn.Font = Enum.Font.GothamMedium
		Btn.TextSize = 13
		Btn.TextXAlignment = Enum.TextXAlignment.Left
		Btn.Parent = Page

		local BtnCorner = Instance.new("UICorner")
		BtnCorner.CornerRadius = UDim.new(0, 6)
		BtnCorner.Parent = Btn

		Btn.MouseButton1Click:Connect(function()
			if callback then pcall(callback) end
		end)
		refreshCanvas()
		return Btn
	end

	function TabObj:CreateToggle(name, defaultState, callback)
		local toggled = defaultState or false

		local ToggleBtn = Instance.new("TextButton")
		ToggleBtn.Size = UDim2.new(1, 0, 0, 30)
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
		ToggleBtn.Text = "  " .. name
		ToggleBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
		ToggleBtn.Font = Enum.Font.GothamMedium
		ToggleBtn.TextSize = 13
		ToggleBtn.TextXAlignment = Enum.TextXAlignment.Left
		ToggleBtn.Parent = Page

		local ToggleCorner = Instance.new("UICorner")
		ToggleCorner.CornerRadius = UDim.new(0, 6)
		ToggleCorner.Parent = ToggleBtn

		local StatusIndicator = Instance.new("Frame")
		StatusIndicator.Size = UDim2.new(0, 12, 0, 12)
		StatusIndicator.AnchorPoint = Vector2.new(1, 0.5)
		StatusIndicator.Position = UDim2.new(1, -10, 0.5, 0)
		StatusIndicator.BackgroundColor3 = toggled and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(60, 60, 60)
		StatusIndicator.Parent = ToggleBtn

		local IndicatorCorner = Instance.new("UICorner")
		IndicatorCorner.CornerRadius = UDim.new(1, 0)
		IndicatorCorner.Parent = StatusIndicator

		ToggleBtn.MouseButton1Click:Connect(function()
			toggled = not toggled
			StatusIndicator.BackgroundColor3 = toggled and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(60, 60, 60)
			if callback then pcall(function() callback(toggled) end) end
		end)

		refreshCanvas()
		return ToggleBtn
	end

	function TabObj:CreateSlider(name, minVal, maxVal, defaultVal, callback)
		local minN = minVal or 0
		local maxN = maxVal or 100
		local currentVal = math.clamp(defaultVal or minN, minN, maxN)

		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 0, 44)
		Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
		Frame.BorderSizePixel = 0
		Frame.Parent = Page

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = Frame

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(0.7, 0, 0, 20)
		Label.Position = UDim2.new(0, 10, 0, 4)
		Label.BackgroundTransparency = 1
		Label.Text = name
		Label.TextColor3 = Color3.fromRGB(230, 230, 230)
		Label.Font = Enum.Font.GothamMedium
		Label.TextSize = 13
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Frame

		local ValueLbl = Instance.new("TextLabel")
		ValueLbl.Size = UDim2.new(0.3, -10, 0, 20)
		ValueLbl.Position = UDim2.new(0.7, 0, 0, 4)
		ValueLbl.BackgroundTransparency = 1
		ValueLbl.Text = tostring(currentVal)
		ValueLbl.TextColor3 = Color3.fromRGB(0, 255, 120)
		ValueLbl.Font = Enum.Font.GothamBold
		ValueLbl.TextSize = 12
		ValueLbl.TextXAlignment = Enum.TextXAlignment.Right
		ValueLbl.Parent = Frame

		local BarBg = Instance.new("TextButton")
		BarBg.Size = UDim2.new(1, -20, 0, 8)
		BarBg.Position = UDim2.new(0, 10, 0, 28)
		BarBg.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		BarBg.Text = ""
		BarBg.AutoButtonColor = false
		BarBg.Parent = Frame

		local BarCorner = Instance.new("UICorner")
		BarCorner.CornerRadius = UDim.new(1, 0)
		BarCorner.Parent = BarBg

		local initPct = (maxN > minN) and ((currentVal - minN) / (maxN - minN)) or 0
		local Fill = Instance.new("Frame")
		Fill.Size = UDim2.new(initPct, 0, 1, 0)
		Fill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
		Fill.BorderSizePixel = 0
		Fill.Parent = BarBg

		local FillCorner = Instance.new("UICorner")
		FillCorner.CornerRadius = UDim.new(1, 0)
		FillCorner.Parent = Fill

		local sliding = false
		local function updateFromX(posX)
			local pct = math.clamp((posX - BarBg.AbsolutePosition.X) / math.max(1, BarBg.AbsoluteSize.X), 0, 1)
			local val = math.floor(minN + (maxN - minN) * pct)
			currentVal = val
			ValueLbl.Text = tostring(val)
			Fill.Size = UDim2.new(pct, 0, 1, 0)
			if callback then pcall(function() callback(val) end) end
		end

		BarBg.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				updateFromX(input.Position.X)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				updateFromX(input.Position.X)
			end
		end)

		refreshCanvas()
		return Frame
	end

	function TabObj:CreateTextBox(name, placeholder, callback)
		local Frame = Instance.new("Frame")
		Frame.Size = UDim2.new(1, 0, 0, 30)
		Frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
		Frame.Parent = Page

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = Frame

		local Label = Instance.new("TextLabel")
		Label.Size = UDim2.new(0.45, -10, 1, 0)
		Label.Position = UDim2.new(0, 10, 0, 0)
		Label.BackgroundTransparency = 1
		Label.Text = name
		Label.TextColor3 = Color3.fromRGB(230, 230, 230)
		Label.Font = Enum.Font.GothamMedium
		Label.TextSize = 13
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Frame

		local BoxInput = Instance.new("TextBox")
		BoxInput.Size = UDim2.new(0.52, -10, 0, 22)
		BoxInput.Position = UDim2.new(0.48, 0, 0.5, -11)
		BoxInput.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		BoxInput.PlaceholderText = placeholder or "Type..."
		BoxInput.Text = ""
		BoxInput.TextColor3 = Color3.fromRGB(255, 255, 255)
		BoxInput.PlaceholderColor3 = Color3.fromRGB(130, 130, 130)
		BoxInput.Font = Enum.Font.Gotham
		BoxInput.TextSize = 12
		BoxInput.ClearTextOnFocus = false
		BoxInput.Parent = Frame

		local BoxCorner = Instance.new("UICorner")
		BoxCorner.CornerRadius = UDim.new(0, 4)
		BoxCorner.Parent = BoxInput

		BoxInput.FocusLost:Connect(function()
			if callback then pcall(function() callback(BoxInput.Text) end) end
		end)

		refreshCanvas()
		return BoxInput
	end

	function TabObj:CreateLabel(text)
		local Lbl = Instance.new("TextLabel")
		Lbl.Size = UDim2.new(1, 0, 0, 24)
		Lbl.BackgroundTransparency = 1
		Lbl.Text = "  " .. text
		Lbl.TextColor3 = Color3.fromRGB(180, 180, 180)
		Lbl.TextSize = 12
		Lbl.Font = Enum.Font.Gotham
		Lbl.TextXAlignment = Enum.TextXAlignment.Left
		Lbl.Parent = Page
		refreshCanvas()
		return Lbl
	end

	return TabObj
end

function SUFFIX:Close(windowInstance)
	if windowInstance and windowInstance.ScreenGui then
		windowInstance.ScreenGui:Destroy()
	end
end


function SUFFIX:ResolveIcon(iconInput)
	if type(iconInput) ~= "string" then
		return "rbxassetid://14456045412"
	end
	if iconInput:find("rbxassetid://") or iconInput:find("rbxthumb://") or iconInput:find("http") then
		return iconInput
	end
	local key = iconInput:lower():gsub("[%s_%-]", "")
	return self.Icons[key] or "rbxassetid://14456045412"
end

